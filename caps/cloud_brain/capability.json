{
  "name": "cloud_brain",
  "version": "1.0.0",
  "description": "云端大脑 · 云端LLM推理集群/分布式知识库/云端同步/远程GPU推理/云端存储KV。本地+云端双模无缝切换",
  "language": "python",
  "risk_level": "safe",
  "auto_exec": true,
  "category": "AI",
  "entry": {
    "program": "python",
    "args": [
      "run.py"
    ]
  },
  "triggers": {
