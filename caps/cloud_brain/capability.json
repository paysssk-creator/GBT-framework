      "云端",
      "cloud",
      "远程推理",
      "GPU",
      "分布式",
      "云端存储",
      "云同步",
      "cloud brain",
      "集群"
    ],
    "intent": "cloud_brain",
    "examples": [
      "云端推理",
      "同步到云端",
      "使用云端GPU"
    ]
  },
  "actions": {
    "reason": {
      "description": "reason",
      "args": [
        "--action",
        "reason"
      ],
      "input": "stdin",
      "timeout_ms": 30000,
      "output": "json"
    },
    "ask": {
      "description": "ask",
      "args": [
