{
  "name": "ai_vision",
  "version": "1.0.0",
  "description": "AI视觉 — Florence-2 图片理解+OCR+描述",
  "language": "python",
  "priority": 12,
  "pipeline_role": "analyze",
  "depends_on": [
    "screenshot"
  ],
  "triggers": {
    "intent": "vision_ai",
    "keywords": [
      "看图",
      "识别图片",
      "图片里有什么",
      "vision",
      "AI视觉",
      "看懂",
      "图片文字",
      "描述图片",
      "图像识别",
      "OCR识别"
    ],
    "examples": [
      "看看图片里有什么",
      "识别这张图",
      "图片上的文字是什么",
      "描述一下这个画面"
    ]
  },
  "entry": {
    "program": "python",
    "args": [
      "run.py"
    ]
  },
  "actions": {
    "ocr": {
      "description": "识别图片中的文字 (Florence-2 OCR)",
      "args": [
        "ocr"
      ],
      "input": "stdin",
      "timeout_ms": 60000,
      "output": "json"
    },
    "describe": {
      "description": "AI描述图片内容",
      "args": [
        "describe"
      ],
      "input": "stdin",
      "timeout_ms": 60000,
      "output": "json"
    },
    "screen": {
      "description": "截图+AI理解当前屏幕",
      "args": [
        "screen"
      ],
      "timeout_ms": 60000,
      "output": "json"
    }
  },
  "risk_level": "safe",
  "auto_exec": true,
  "category": "感知域"
}
