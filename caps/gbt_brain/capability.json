    "autonomous": {
      "description": "autonomous",
      "args": [
        "--action",
        "autonomous"
      ],
      "input": "stdin",
      "timeout_ms": 30000,
      "output": "json"
    },
    "task": {
      "description": "task",
      "args": [
        "--action",
        "task"
      ],
      "input": "stdin",
      "timeout_ms": 30000,
      "output": "json"
    }
  }
}