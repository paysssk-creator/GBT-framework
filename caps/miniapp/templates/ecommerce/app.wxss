/* {{PROJECT_NAME}} — 全局样式 */

page {
  --primary: #ff6b35;
  --primary-light: #ff8c5a;
  --bg: #f5f5f5;
  --text: #333333;
  --text-light: #999999;
  --border: #eeeeee;
  --white: #ffffff;
  --red: #e74c3c;
  --gold: #f0ad4e;

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ─── 通用组件 ─── */
.container { padding: 20rpx; box-sizing: border-box; }

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: var(--white);
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary:active { opacity: 0.85; }

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border: 2rpx solid var(--primary);
  border-radius: 36rpx;
  color: var(--primary);
  font-size: 28rpx;
}

.price { color: var(--red); font-weight: 700; }
.price-sm { color: var(--red); font-weight: 600; font-size: 26rpx; }
.price-lg { color: var(--red); font-weight: 700; font-size: 36rpx; }
.price-symbol { font-size: 24rpx; }

.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--red);
  color: var(--white);
  font-size: 20rpx;
  padding: 0 6rpx;
}

.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-col { display: flex; flex-direction: column; }
