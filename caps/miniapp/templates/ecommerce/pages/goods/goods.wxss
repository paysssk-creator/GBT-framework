/* pages/goods/goods.wxss — 商品详情 */

.page { padding-bottom: 120rpx; }

/* 图片轮播 */
.goods-swiper {
  width: 100%;
  height: 750rpx;
  background: var(--white);
}

.goods-image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.goods-info {
  padding: 24rpx 20rpx;
  background: var(--white);
  margin-bottom: 16rpx;
}

.goods-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.original-price {
  font-size: 26rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 16rpx;
}

.goods-sales {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 规格 */
.spec-section {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx;
  background: var(--white);
  margin-bottom: 16rpx;
}

.spec-label {
  font-size: 28rpx;
  color: var(--text-light);
  margin-right: 20rpx;
  min-width: 60rpx;
}

.spec-tags { display: flex; flex-wrap: wrap; }

.spec-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  background: var(--bg);
  border-radius: 8rpx;
  font-size: 26rpx;
}

/* 数量 */
.qty-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background: var(--white);
  margin-bottom: 16rpx;
}

.qty-label { font-size: 28rpx; color: var(--text-light); }

.qty-stepper {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
  font-size: 32rpx;
  color: var(--text);
  border-radius: 6rpx;
}

.qty-btn.disabled { color: var(--text-light); background: var(--bg); }

.qty-value {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 详情 */
.desc-section {
  background: var(--white);
  padding: 24rpx 20rpx;
}

.desc-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid var(--primary);
}

.desc-content { font-size: 28rpx; line-height: 1.8; }

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 100rpx;
  background: var(--white);
  border-top: 1rpx solid var(--border);
}

.bottom-cart,
.bottom-buy {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.bottom-cart {
  background: linear-gradient(135deg, var(--gold), #f5c842);
  color: var(--white);
}

.bottom-buy {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: var(--white);
}
