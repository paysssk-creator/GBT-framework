/* pages/index/index.wxss — 首页 */

.page { padding-bottom: 20rpx; }

/* ─── 搜索栏 ─── */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: var(--bg);
  border-radius: 32rpx;
  padding: 0 20rpx;
}

.search-icon { font-size: 28rpx; margin-right: 10rpx; }
.search-input { flex: 1; font-size: 28rpx; }

.cart-entry {
  position: relative;
  margin-left: 20rpx;
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon { font-size: 40rpx; }

/* ─── 轮播图 ─── */
.banner-swiper {
  width: 100%;
  height: 300rpx;
  margin: 0 0 16rpx 0;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* ─── 分类入口 ─── */
.category-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  margin: 0 20rpx;
  background: var(--white);
  border-radius: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.category-name { font-size: 24rpx; color: var(--text); }

/* ─── 区块标题 ─── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.title-bar {
  color: var(--primary);
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 900;
}

.section-more { font-size: 26rpx; color: var(--text-light); }

/* ─── 商品网格 ─── */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.product-card {
  width: calc(50% - 16rpx);
  margin: 0 8rpx 20rpx;
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
}

.product-img-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 22rpx;
  border-radius: 6rpx;
}

.product-info { padding: 16rpx; }

.product-name {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.original-price {
  font-size: 24rpx;
  color: var(--text-light);
  text-decoration: line-through;
  margin-left: 10rpx;
}
