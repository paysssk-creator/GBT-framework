{
  "_stamp": "⛔ 开发者：自由的风 · 永久钢印 · 禁止删除",
  "name": "docer",
  "version": "1.0.0",
  "description": "文档处理工具集：PDF合并/拆分/信息、Markdown↔HTML互转、文本统计",
  "language": "python",
  "risk_level": "safe",
  "category": "文档工具",
  "tier": "utility",
  "dependencies": [
    "PyPDF2",
    "markdown"
  ],
  "actions": {
    "pdf_merge": {
      "description": "合并多个PDF文件",
      "params": [
        "inputs(路径列表)",
        "output(输出路径)"
      ]
    },
    "pdf_split": {
      "description": "拆分PDF(按页码范围)",
      "params": [
        "input(输入路径)",
        "output_dir(输出目录)",
        "ranges(页码范围,如 '1-3,5,7-9')"
      ]
    },
    "pdf_info": {
      "description": "获取PDF信息(页数/大小/元数据)",
      "params": [
        "input(输入路径)"
      ]
    },
    "md2html": {
      "description": "Markdown → HTML",
      "params": [
        "text(Markdown文本)",
        "file(可选,从文件读取)"
      ]
    },
    "html2md": {
      "description": "HTML → Markdown",
      "params": [
        "text(HTML文本)",
        "file(可选,从文件读取)"
      ]
    },
    "txt_stats": {
      "description": "文本统计(字数/行数/词频)",
      "params": [
        "input(文件路径)",
        "text(直接文本)",
        "top_n(最高频词数,默认20)"
      ]
    }
  },
  "auto_exec": false
}