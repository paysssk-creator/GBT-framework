{
  "name": "gbt-nano-browser-pro",
  "version": "1.0.0",
  "description": "GBT Nano Browser Pro — AI全控内置浏览器 · 指纹隐身 · 2Captcha · 股票操盘",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.gbt.nano-browser-pro",
    "productName": "GBT Nano Browser Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "server/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      "server/bridge.py"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
